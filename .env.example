# Copy to .env.local and fill in. Never commit .env.local.

# Contact form
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO=

# Neon Postgres (Dashboard > Connection Details > pooled connection string)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Password for /user, checked server-side only
EDIT_PASSWORD=

# HMAC key for the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
